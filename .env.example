# Copy this file to .env and fill in the values. Never commit .env.

# Groq: cloud fallback LLM (https://console.groq.com)
GROQ_API_KEY=

# Langfuse Cloud: tracing (https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Your Langfuse region URL, for example the EU or US cloud address shown in your project settings
LANGFUSE_HOST=
